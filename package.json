{
  "name": "show-me",
  "version": "0.8.0",
  "description": "Coding agents show their work to a person: diagrams, diffs and decision blocks in a page they read and answer",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "show-proposal": "./bin/show-proposal.js",
    "show-architecture": "./bin/show-architecture.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "show-proposal": "tsx src/cli/index.ts",
    "show-architecture": "tsx src/cli/architecture.ts",
    "example": "tsx src/cli/index.ts example proposal.json",
    "validate": "tsx src/cli/index.ts validate proposal.json",
    "review": "tsx src/cli/index.ts review proposal.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "commander": "^12.1.0",
    "hono": "^4.6.14",
    "marked": "^14.1.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.9"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true,
    "esbuild@0.25.12": true
  }
}
